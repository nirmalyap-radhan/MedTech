# ==============================================================================
# MediKiok Enterprise Clinical Stack — Environment Configuration Template
# ==============================================================================

# Sarvam AI API Key (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key (Clinical Triage & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Production Database (PostgreSQL / Supabase / Neon)
# Leave commented to run on local persistent SQLite
# DATABASE_URL=postgresql://postgres:password@localhost:5432/medikiok_clinical

# Production Vector Database (pgvector / ChromaDB / Qdrant)
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=

# Object Storage for Prescription Scans and Audio Files
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=medikiok-clinical-records
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
